# 1. Change prefix from Ctrl-b to Ctrl-s (More ergonomic)
set -g prefix C-s
unbind C-b
bind C-s send-prefix

# Switch tmux windows without the prefix
set -g extended-keys on
# Preserve modified keys through physical terminals and nested tmux clients.
# Fixed array indexes make reloading this config idempotent.
set -g terminal-features[100] 'xterm*:extkeys'
set -g terminal-features[101] 'konsole*:extkeys'
set -g terminal-features[102] 'tmux*:extkeys'
bind-key -n C-Tab next-window
bind-key -n C-BTab previous-window

# Toggle passthrough mode for nested tmux sessions over SSH. While enabled,
# this tmux layer only handles F12 and forwards every other key to the pane.
bind-key -T root F12 \
  set-option prefix None \; \
  set-option key-table off \; \
  set-option status-style "bg=colour52,fg=colour255" \; \
  display-message "TMUX PASSTHROUGH"
bind-key -T off F12 \
  set-option -u prefix \; \
  set-option -u key-table \; \
  set-option -u status-style \; \
  display-message "TMUX ACTIVE"

# 2. Bind 'r' to reload configuration easily
unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display-message "Config reloaded!"

# 3. Enable mouse support (Resizing panes, selecting windows)
set -g mouse on

# Start windows and panes at 1, not 0
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

# 4. Use Vim keys (h, j, k, l) for pane navigation
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# Split panes using | and - (and open in current directory)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# 5. Move status bar to the top
set-option -g status-position top

# 6. Vi-style keys in copy mode
set -g mode-keys vi

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
# === Arch Linux Clipboard (Wayland) ===
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "wl-copy"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
# === Ubuntu Server Clipboard (OSC 52 over SSH) ===
set -s set-clipboard on
bind -T copy-mode-vi y send -X copy-selection-and-cancel
{{ else if eq .chezmoi.os "darwin" -}}
# === macOS Clipboard ===
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "pbcopy"
{{ end -}}

# =====================================
# Tmux Plugin Manager (TPM) & Plugins
# =====================================

# List of plugins
set -g @plugin 'tmux-plugins/tpm'

# Neutral theme
set -g status-style "bg=colour235,fg=colour250"
set -g status-justify centre
set -g status-left-length 40
set -g status-right-length 60
set -g status-left "#{?client_prefix,#[bg=colour250\,fg=colour235\,bold] PREFIX #[bg=colour235] ,}#[fg=colour255,bold] #S #[default]"
set -g status-right "#[fg=colour245]%Y-%m-%d  %H:%M "

set -g window-status-separator ""
set -g window-status-format "#[fg=colour245] #I:#W "
set -g window-status-current-format "#[bg=colour240,fg=colour255,bold] #I:#W #[default]"
set -g window-status-activity-style "fg=colour255,bold"

set -g pane-border-style "fg=colour238"
set -g pane-active-border-style "fg=colour245"
set -g message-style "bg=colour240,fg=colour255"
set -g mode-style "bg=colour240,fg=colour255"
set -g clock-mode-colour colour245

# Initialize TMUX plugin manager (Keep this line at the very bottom)
run '~/.config/tmux/plugins/tpm/tpm'
