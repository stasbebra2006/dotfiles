export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="/usr/bin:$PATH"
# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(git)

source $ZSH/oh-my-zsh.sh

# Prefer exact-case completion before falling back to case-insensitive matches.
zstyle ':completion:*' matcher-list '' \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' \
  'r:|=*' \
  'l:|=* r:|=*'

# PATH
export PATH="$HOME/.local/bin:$PATH"

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
# === Arch Linux Only ===
alias mainconfig="nvim ~/.config/hypr/hyprland.conf"
alias update="sudo pacman -Syu --noconfirm && paru -Sua --noconfirm"
alias zz="systemctl suspend"
alias suspend="systemctl suspend"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
# === Ubuntu Server Only ===
alias update="sudo apt update && sudo apt upgrade"
{{ else if eq .chezmoi.os "darwin" -}}
# === macOS Only ===
eval "$(/opt/homebrew/bin/brew shellenv)"
alias update="brew update && brew upgrade --no-ask && brew cleanup"
{{ end -}}

# === Shared Tools ===
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

export EDITOR="nvim"
export SUDO_EDITOR="nvim"
