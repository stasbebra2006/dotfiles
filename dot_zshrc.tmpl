# === Shared configuration ===

# --- Oh My Zsh ---
# Configure the installation path, prompt theme, and plugins before loading it.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
# Source the loader in this shell so its changes persist.
source "$ZSH/oh-my-zsh.sh"

# --- Completion ---
# Try exact completion first, then case-insensitive and broader partial matches.
zstyle ':completion:*' matcher-list '' \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' \
  'r:|=*' \
  'l:|=* r:|=*'

# --- User binaries ---
# Prepend ~/.local/bin directly so user executables (such as nvim-own) are
# indexed cleanly for zsh completion without paths containing '..'.
if [[ -d "$HOME/.local/bin" && ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

if [[ -d "$HOME/.openclaw/bin" && ":$PATH:" != *":$HOME/.openclaw/bin:"* ]]; then
  export PATH="$HOME/.openclaw/bin:$PATH"
fi

# --- Editor ---
# Use Neovim for general command-line editing and privileged sudoedit sessions.
export EDITOR="nvim"
export SUDO_EDITOR="nvim"

# === OS-specific configuration ===
# Chezmoi renders only the matching branch.

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
# --- Arch Linux ---
# Prepend the verified user npm bin directory only when needed.
if [[ -d "$HOME/.npm-global/bin" && ":$PATH:" != *":$HOME/.npm-global/bin:"* ]]; then
  export PATH="$HOME/.npm-global/bin:$PATH"
fi
# Update official and AUR packages without prompts, then Oh My Pi.
alias update="sudo pacman -Syu --noconfirm && paru -Sua --noconfirm && omp update"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
# --- Ubuntu Server ---
# Refresh apt metadata and upgrade packages, then update Oh My Pi.
alias update="sudo apt update && sudo apt upgrade && omp update"
{{ else if eq .chezmoi.os "darwin" -}}
# --- macOS ---
# Import Homebrew's generated environment into this shell.
eval "$(/opt/homebrew/bin/brew shellenv)"
# Update and clean up Homebrew packages, then update Oh My Pi.
alias update="brew update && brew upgrade --no-ask && brew cleanup && omp update"
{{ end -}}
