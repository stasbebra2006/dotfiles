# Disable system wake from every USB device and root hub.
# Includes devices connected later; the power button remains available.
ACTION=="add|bind|change", SUBSYSTEM=="usb", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"

# Block the USB host controller wake path as well (PCI class 0c03xx).
ACTION=="add|bind|change", SUBSYSTEM=="pci", ATTR{class}=="0x0c03*", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
